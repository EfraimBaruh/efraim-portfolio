{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "static-out",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3001",
        "-d",
        "out"
      ],
      "port": 3001
    },
    {
      "name": "static-gzip",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve@14",
        "out",
        "-l",
        "3002"
      ],
      "port": 3002
    }
  ]
}
